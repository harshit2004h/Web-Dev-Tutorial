<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dummy Data Generator</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        box-sizing: border-box;
      }
      body {
        background-color: burlywood;
      }
      .box {
        background-color: aquamarine;
        border: 5px solid black;
        margin: auto;
        width: 900px;
        margin-top: 100px;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        align-items: center;
        height: 300px;
      }
      button {
        border: none;
        border: 3px solid black;
        background-color: rgb(246, 246, 167);
        border-radius: 10px;
        height: 100px;
        width: 300px;
        font-size: 35px;
        font-weight: bold;
        cursor: pointer;
      }
      button:hover {
        background-color: rgb(247, 247, 123);
        border: 5px solid black;
      }
      h1 {
        font-size: 50px;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>Click Here to Generate Random Data</h1>
      <button class="GenData">Generate Data</button>
    </div>
    <script>
      document
        .querySelector(".GenData")
        .addEventListener("click", async (params) => {
          let a = await fetch("/generate");
          let = await a.json();
          console.log(r);
        });
    </script>
  </body>
</html>
